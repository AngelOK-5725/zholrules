# ============================================
# ZholRules — пример переменных окружения
# Скопируйте в .env и заполните своими значениями.
# .env в .gitignore: настоящие ключи в репозиторий не попадают.
# ============================================

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ваш Telegram id — только он получает админку
OWNER_TELEGRAM_ID=
# Секрет проверки вебхука (заголовок X-Telegram-Bot-Api-Secret-Token).
# Если оставить пусто — значение выводится из токена бота.
TELEGRAM_WEBHOOK_SECRET=
# Токен платёжного провайдера (для Stars не нужен)
TELEGRAM_PAYMENTS_PROVIDER_TOKEN=

# --- База данных ---
# postgresql://user:password@host/dbname?sslmode=require
# Пусто = локальный SQLite (данные не переживут переезд)
DATABASE_URL=

# --- Flask ---
# Обязательно задайте: иначе подпись сессий на публичном дефолте
SECRET_KEY=
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# --- Медиа ---
# Медиа хранятся в таблице media (Postgres). Эта папка — только аварийный
# фолбэк на диск: на платформе с эфемерным диском файлы там не живут.
MEDIA_FOLDER=uploads

# --- CORS ---
CORS_ORIGINS=https://angelok-5725.github.io

# --- Лимиты ---
RATE_LIMIT_DEFAULT=200 per minute
RATE_LIMIT_API=120 per minute

# --- Логи ---
LOG_LEVEL=INFO
LOG_FILE=logs/zholrules.log

# --- Cloudinary (приложением не используется, оставлено для совместимости) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
