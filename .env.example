# ============================================
# ZholRules — Environment Variables
# Скопируй этот файл в .env и заполни значения
# ============================================

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram WebApp Secret (из BotFather -> Bot Settings -> WebApp)
TELEGRAM_WEBAPP_SECRET=your_webapp_secret_here

# Telegram ID владельца (для админки)
OWNER_TELEGRAM_ID=123456789

# --- Database ---
# SQLite (по умолчанию)
DATABASE_URL=sqlite:///zholrules.db

# PostgreSQL (для продакшна)
# DATABASE_URL=postgresql://user:password@localhost:5432/zholrules

# --- Server ---
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key для Flask сессий
SECRET_KEY=change-this-to-a-random-string

# --- Media Storage ---
MEDIA_STORAGE=local
MEDIA_FOLDER=./uploads

# Cloudinary (для загрузки фото/видео)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments ---
TELEGRAM_PAYMENTS_PROVIDER_TOKEN=

# --- Security ---
RATE_LIMIT_DEFAULT=100 per hour
RATE_LIMIT_API=200 per hour
CORS_ORIGINS=http://localhost:5000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/zholrules.log
